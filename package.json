{
  "name": "550w-ai-mcp-plugin",
  "version": "3.1.1",
  "description": "Remove image watermarks, local video subtitles or visual watermarks, and platform watermarks from copied video links with the 550W Open API",
  "main": "dist/index.js",
  "bin": {
    "550w-upload-mcp": "dist/550w-upload-mcp.cjs"
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "npm run build --silent && node --test test/oauth-media-uploader.test.js",
    "bundle": "npm run build && esbuild dist/oauth-upload-mcp-server.js --bundle --platform=node --target=node18 --format=cjs --outfile=dist/550w-upload-mcp.cjs"
  },
  "files": [
    "dist/",
    "references/",
    "skill.json",
    "SKILL.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.20.0",
    "form-data": "^4.0.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.5"
  }
}
